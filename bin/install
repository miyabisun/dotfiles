#!/bin/bash
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir/../" || exit 1

function link () {
  from="$(pwd)/$1"
  to="${2:-$HOME}"
  if ! ln -sfv "$from" "$to"; then
    echo "Failed to link $from to $to" >&2
    exit 1
  fi
}

# machine-local config: the live file is an independent copy, never a symlink
# into the repo. The harness writes runtime state (model, session) back into it,
# and that state is not dotfiles' to carry — `config-merge` syncs the portable
# intent instead. Seed from the template when missing, migrate the legacy
# dotfiles symlink once (preserving its contents), and never overwrite an
# existing file.
function local_config () {
  local live="$1" source="$2" tmp
  if [ -L "$live" ] && [ "$(readlink "$live")" = "$source" ]; then
    tmp="${live}.tmp.$$"
    cp -L "$live" "$tmp"
    unlink "$live"
    mv "$tmp" "$live"
  elif [ ! -e "$live" ] && [ ! -L "$live" ]; then
    cp "$source" "$live"
  fi
}

link ".editorconfig"


mkdir -p "$HOME/.ssh/conf.d"
link "ssh/config" "$HOME/.ssh"

mkdir -p "$HOME/.config"
link "config/git" "$HOME/.config"
link "config/nvim" "$HOME/.config"
link "config/tmux" "$HOME/.config"

mkdir -p "$HOME/.claude"
link "agent/common/skills" "$HOME/.claude"
link "agent/common/agents" "$HOME/.claude"
link "agent/common/designs" "$HOME/.claude"
link "agent/claude/hooks" "$HOME/.claude"
link "agent/claude/CLAUDE.md" "$HOME/.claude"
# CLAUDE.md imports the shared rules via @~/.claude/GLOBAL.md
link "agent/common/rules/GLOBAL.md" "$HOME/.claude"
local_config "$HOME/.claude/settings.json" "$(pwd)/agent/claude/settings.json"

# herdr: ~/.config/herdr はランタイム実ディレクトリ (sock/log/session) のため
# dir ごとではなく config.toml だけをファイル単位で張る
mkdir -p "$HOME/.config/herdr"
link "config/herdr/config.toml" "$HOME/.config/herdr"
# keys.command から呼ぶ並び替え helper (PATH 経由)
mkdir -p "$HOME/.local/bin"
link "config/herdr/bin/herdr-swap" "$HOME/.local/bin"

mkdir -p "$HOME/.codex"
local_config "$HOME/.codex/config.toml" "$(pwd)/agent/codex/config.toml"

link "agent/codex/hooks.json" "$HOME/.codex"
# hooks.json は ~/.codex/hooks/ の安定リンク経由で script を参照する
link "agent/codex/hooks" "$HOME/.codex"
link "agent/codex/agents" "$HOME/.codex"
link "agent/common/rules/GLOBAL.md" "$HOME/.codex/AGENTS.md"
agent/common/bin/install-agent-runtime || exit 1

# Grok: config.toml is machine-local (auth/marketplace/runtime stay out of the
# repo). Seed from the portable template when missing; never overwrite an
# existing file. Hooks/skills/agents/rules are pure symlinks.
mkdir -p "$HOME/.grok"
local_config "$HOME/.grok/config.toml" "$(pwd)/agent/grok/config.toml"
link "agent/grok/hooks" "$HOME/.grok"
link "agent/common/skills" "$HOME/.grok"
link "agent/common/agents" "$HOME/.grok"
link "agent/common/designs" "$HOME/.grok"
link "agent/common/rules/GLOBAL.md" "$HOME/.grok/AGENTS.md"

# 旧 seed が user-home 絶対パスで焼いていた agent-talk adapter 行だけを
# portable 形式へ移行する。一致は user home root (/home/<user>, /Users/<user>)
# + 既知の adapter suffix に限定し、custom prefix やほかの machine-local
# 編集には触れない (全体の調停は config-merge の領分)。root 直後で literal が
# 途切れるため portable-paths guard には掛からない。
legacy_adapter_re='^command = "(/home/|/Users/)[A-Za-z0-9_][A-Za-z0-9_-]*/\.local/share/agent-talk/current/agent-talk-mcp"$'
migrate_legacy_mcp_command() {
  cfg="$1"
  mode="$2"
  [ -f "$cfg" ] || return 0
  [ -L "$cfg" ] && return 0
  grep -Eq "$legacy_adapter_re" "$cfg" || return 0
  # machine-local config は 0600 があり得る。mktemp + cp -p で mode を
  # 引き継ぎ、redirect は truncate だけに使う。regex は awk -v だと実装
  # 依存の backslash 展開を受けるので ENVIRON で bytes のまま渡す。
  cfg_tmp="$(mktemp "${cfg}.XXXXXX")" || return 1
  if ! cp -p "$cfg" "$cfg_tmp"; then
    rm -f "$cfg_tmp"
    return 1
  fi
  if [ "$mode" = codex ]; then
    LEGACY_ADAPTER_RE="$legacy_adapter_re" awk '
      BEGIN { re = ENVIRON["LEGACY_ADAPTER_RE"] }
      $0 ~ re {
        print "command = \"sh\""
        print "args = [\"-c\", \"exec \\\"$HOME/.local/share/agent-talk/current/agent-talk-mcp\\\"\"]"
        next
      }
      { print }
    ' "$cfg" >"$cfg_tmp" || { rm -f "$cfg_tmp"; return 1; }
  else
    LEGACY_ADAPTER_RE="$legacy_adapter_re" awk '
      BEGIN { re = ENVIRON["LEGACY_ADAPTER_RE"] }
      $0 ~ re {
        print "command = \"${HOME}/.local/share/agent-talk/current/agent-talk-mcp\""
        next
      }
      { print }
    ' "$cfg" >"$cfg_tmp" || { rm -f "$cfg_tmp"; return 1; }
  fi
  mv "$cfg_tmp" "$cfg"
  echo "migrated legacy agent-talk adapter path in $cfg"
}
migrate_legacy_mcp_command "$HOME/.codex/config.toml" codex
migrate_legacy_mcp_command "$HOME/.grok/config.toml" grok

mkdir -p "$HOME/.agents"
link "agent/common/skills" "$HOME/.agents"
link "agent/common/agents" "$HOME/.agents"
link "agent/common/designs" "$HOME/.agents"

link "agent/codex/hooks/notify-turn-end.sh" "$HOME/.local/bin"
# codex exec 召喚の共通起動形 (spike / polish / chore / knowledge-deposit)
link "agent/common/bin/review" "$HOME/.local/bin"
# timeout(1) が macOS に無いことの吸収。review が打ち切りをここへ委譲する
link "agent/common/bin/with-timeout" "$HOME/.local/bin"
# 日本語明晰化 (本体は bin/install-apps が ~/.local/share/meiseki へ置く)
# meiseki-common.sh は実体の隣から source される library なので link しない
link "agent/common/bin/meiseki" "$HOME/.local/bin"
link "agent/common/bin/meiseki-lint" "$HOME/.local/bin"
link "agent/common/bin/meiseki-rewrite" "$HOME/.local/bin"
link "config/tmux/bin/tmux-session-picker" "$HOME/.local/bin"
link "config/tmux/bin/tmux-mux" "$HOME/.local/bin"

mkdir -p "$HOME/.config/sheldon"
link "config/zsh/plugins.toml" "$HOME/.config/sheldon"
command -v sheldon > /dev/null && sheldon lock

START_MARK="# DOTFILES_START"
END_MARK="# DOTFILES_END"

# rc へ書く行は自己位置から導出した repo root の絶対パスを焼き込む。
# rc は machine-local なので portable 制約は無く、legacy root には依存しない。
repo_root="$(pwd)"
EXPORTS_LINE="[ -f \"$repo_root/config/bash/exports.sh\" ] && . \"$repo_root/config/bash/exports.sh\""
ZSH_LINE="[ -f \"$repo_root/config/zsh/init.zsh\" ] && . \"$repo_root/config/zsh/init.zsh\""

# managed block の管理は 2 相で行う。第 1 相 (read-only preflight) で全対象
# rc の marker を検証し、1 件でも破損 (片方欠け・順序逆・複数) があれば
# どの rc にも書き込まずに abort する。全件 valid のときだけ第 2 相で
# 追加 (0 組) / 丸ごと置換 (1 組) を行う。
validate_rc_block() {
  rcfile="$1"
  [ -f "$rcfile" ] || return 0
  starts="$(grep -cFx "$START_MARK" "$rcfile" || true)"
  ends="$(grep -cFx "$END_MARK" "$rcfile" || true)"
  if [ "$starts" -eq 0 ] && [ "$ends" -eq 0 ]; then
    return 0
  fi
  if [ "$starts" -ne 1 ] || [ "$ends" -ne 1 ]; then
    echo "Broken dotfiles block in $rcfile ($starts start / $ends end markers); fix it manually." >&2
    return 1
  fi
  start_line="$(grep -nFx "$START_MARK" "$rcfile" | cut -d: -f1)"
  end_line="$(grep -nFx "$END_MARK" "$rcfile" | cut -d: -f1)"
  if [ "$start_line" -gt "$end_line" ]; then
    echo "Broken dotfiles block in $rcfile (end marker before start); fix it manually." >&2
    return 1
  fi
  return 0
}

install_rc_block() {
  rcfile="$1"
  block="$2"
  [ -f "$rcfile" ] || return 0
  starts="$(grep -cFx "$START_MARK" "$rcfile" || true)"
  if [ "$starts" -eq 0 ]; then
    if ! printf '\n%s\n' "$block" >> "$rcfile"; then
      echo "Failed to append dotfiles block to $rcfile" >&2
      exit 1
    fi
    echo "Added dotfiles block to $rcfile."
    return 0
  fi
  start_line="$(grep -nFx "$START_MARK" "$rcfile" | cut -d: -f1)"
  end_line="$(grep -nFx "$END_MARK" "$rcfile" | cut -d: -f1)"
  rc_tmp="$(mktemp)" || exit 1
  # render 失敗 (head/tail どれか 1 つでも) は成功表示せず nonzero で終える
  if ! {
    head -n "$((start_line - 1))" "$rcfile" \
      && printf '%s\n' "$block" \
      && tail -n "+$((end_line + 1))" "$rcfile"
  } > "$rc_tmp"; then
    rm -f "$rc_tmp"
    echo "Failed to render dotfiles block for $rcfile" >&2
    exit 1
  fi
  # rc が symlink でも inode と permission を保ったまま中身だけ入れ替える
  if ! cat "$rc_tmp" > "$rcfile"; then
    rm -f "$rc_tmp"
    echo "Failed to write dotfiles block to $rcfile" >&2
    exit 1
  fi
  rm -f "$rc_tmp"
  echo "Replaced dotfiles block in $rcfile."
}

rc_preflight_failed=0
for rcfile in "$HOME/.bashrc" "$HOME/.zshrc"; do
  validate_rc_block "$rcfile" || rc_preflight_failed=1
done
if [ "$rc_preflight_failed" -ne 0 ]; then
  echo "No rc file was modified." >&2
  exit 1
fi

install_rc_block "$HOME/.bashrc" "$START_MARK
$EXPORTS_LINE
$END_MARK"
install_rc_block "$HOME/.zshrc" "$START_MARK
$EXPORTS_LINE
$ZSH_LINE
$END_MARK"

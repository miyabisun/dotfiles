#!/usr/bin/env bash
# Install CLI tools across Manjaro / Ubuntu(WSL) / macOS.
# Requirements: git, cargo (rustup). Run after bin/install for PATH setup.
set -euo pipefail

run_remote_installer() {
  local name="$1"
  local url="$2"
  local installer
  local status

  installer="$(mktemp)"
  if curl --proto '=https' --tlsv1.2 -fsSL "$url" -o "$installer" && bash "$installer"; then
    rm -f "$installer"
    return
  else
    status=$?
  fi

  rm -f "$installer"
  echo "==> Failed to install $name" >&2
  return "$status"
}

# ---------------------------------------------------------------------------
# Agent CLIs — official standalone installers for Linux and macOS
# ---------------------------------------------------------------------------
install_cursor() {
  if command -v cursor-agent >/dev/null 2>&1; then
    echo "==> Cursor CLI already installed ($(cursor-agent --version 2>/dev/null | head -1))"
    return
  fi

  echo "==> Installing Cursor CLI..."
  run_remote_installer "Cursor CLI" "https://cursor.com/install"
  echo "==> Cursor CLI installed"
}

install_codex() {
  if command -v codex >/dev/null 2>&1; then
    echo "==> Codex CLI already installed ($(codex --version 2>/dev/null | head -1))"
    return
  fi

  echo "==> Installing Codex CLI..."
  run_remote_installer "Codex CLI" "https://chatgpt.com/codex/install.sh"
  echo "==> Codex CLI installed"
}

install_agent_clis() {
  install_cursor
  install_codex
}

# ---------------------------------------------------------------------------
# mux — small tmux project launcher
# Install the latest public GitHub release and verify its published checksum.
# ---------------------------------------------------------------------------
install_mux() (
  latest_url="https://github.com/miyabisun/mux/releases/latest"
  target="$HOME/.local/bin/mux"

  if [ -e "$target" ] || [ -L "$target" ]; then
    if [ ! -f "$target" ] || [ ! -x "$target" ] || [ -L "$target" ]; then
      echo "==> Refusing to replace unrecognized mux target: $target" >&2
      return 1
    fi

    version_output="$("$target" --version 2>/dev/null || true)"
    help_output="$("$target" --help 2>/dev/null || true)"
    if printf '%s\n' "$version_output" \
      | grep -Eq '^mux [0-9]+\.[0-9]+\.[0-9]+$' \
      && printf '%s\n' "$help_output" \
        | grep -Eq '^  update[[:space:]]+Update mux from the latest GitHub Release$'; then
      echo "==> Updating mux via mux update..."
      "$target" update
      return
    fi

    echo "==> Refusing to replace unrecognized mux target: $target" >&2
    return 1
  fi

  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)
      archive="mux-linux-x86_64.tar.gz"
      ;;
    Darwin-arm64)
      archive="mux-macos-aarch64.tar.gz"
      ;;
    *)
      echo "==> mux does not support $(uname -s)-$(uname -m)" >&2
      return 1
      ;;
  esac

  redirect_url="$(curl --proto '=https' --tlsv1.2 -fsS \
    -o /dev/null -w '%{redirect_url}' "$latest_url")"
  latest_version="${redirect_url##*/}"
  if ! printf '%s\n' "$latest_version" \
    | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
    echo "==> Cannot determine latest mux version from $redirect_url" >&2
    return 1
  fi

  tmpdir="$(mktemp -d)"
  target_tmp=""
  # 下の trap EXIT から呼ぶ (shellcheck は間接呼び出しを追えない)
  # shellcheck disable=SC2329
  cleanup() {
    rm -rf "$tmpdir"
    [ -z "$target_tmp" ] || rm -f "$target_tmp"
  }
  trap cleanup EXIT
  release_url="https://github.com/miyabisun/mux/releases/download/${latest_version}"

  echo "==> Installing mux ${latest_version}..."
  curl --proto '=https' --tlsv1.2 -fsSL \
    "$release_url/$archive" -o "$tmpdir/$archive"
  curl --proto '=https' --tlsv1.2 -fsSL \
    "$release_url/$archive.sha256" -o "$tmpdir/$archive.sha256"

  read -r expected_hash checksum_name checksum_extra <"$tmpdir/$archive.sha256" || true
  checksum_name="${checksum_name#\*}"
  if [ -n "${checksum_extra:-}" ] \
    || ! printf '%s\n' "${expected_hash:-}" | grep -Eq '^[0-9A-Fa-f]{64}$' \
    || [ "${checksum_name:-}" != "$archive" ]; then
    echo "==> Invalid checksum file for mux ${latest_version}" >&2
    return 1
  fi
  if [ "$(uname -s)" = Darwin ]; then
    actual_hash="$(shasum -a 256 "$tmpdir/$archive" | awk '{ print $1 }')"
  else
    actual_hash="$(sha256sum "$tmpdir/$archive" | awk '{ print $1 }')"
  fi
  if [ "$actual_hash" != "$expected_hash" ]; then
    echo "==> Checksum mismatch for mux ${latest_version}" >&2
    return 1
  fi

  archive_members="$(tar -tzf "$tmpdir/$archive")"
  mux_members=0
  license_members=0
  while IFS= read -r member; do
    case "$member" in
      mux) mux_members=$((mux_members + 1)) ;;
      LICENSE) license_members=$((license_members + 1)) ;;
      *)
        echo "==> Unsafe archive member for mux ${latest_version}: $member" >&2
        return 1
        ;;
    esac
  done <<<"$archive_members"
  if [ "$mux_members" -ne 1 ] || [ "$license_members" -gt 1 ]; then
    echo "==> Invalid archive contents for mux ${latest_version}" >&2
    return 1
  fi

  tar -xzf "$tmpdir/$archive" -C "$tmpdir" mux
  if [ ! -f "$tmpdir/mux" ] || [ -L "$tmpdir/mux" ]; then
    echo "==> Invalid mux binary in release ${latest_version}" >&2
    return 1
  fi
  if [ "$("$tmpdir/mux" --version 2>/dev/null || true)" \
    != "mux ${latest_version#v}" ]; then
    echo "==> mux binary version does not match ${latest_version}" >&2
    return 1
  fi

  mkdir -p "$HOME/.local/bin"
  target_tmp="$(mktemp "$HOME/.local/bin/.mux.XXXXXX")"
  install -m755 "$tmpdir/mux" "$target_tmp"
  mv -f "$target_tmp" "$target"
  target_tmp=""
  echo "==> mux ${latest_version} installed"
)

# ---------------------------------------------------------------------------
# pen — suspend and restore herdr workspaces
# Install the latest public GitHub release and verify its published checksum.
# Idempotency compares `pen --version` with the latest release tag; releases
# older than v0.1.2 lack --version, so an installed or extracted legacy pen is
# recognized by its help banner instead and replaced/accepted on that basis.
# ---------------------------------------------------------------------------
install_pen() (
  latest_url="https://github.com/miyabi-sunny-side/pen-cli/releases/latest"
  target="$HOME/.local/bin/pen"
  recognition='pen — suspend and restore herdr workspaces'

  installed_version=""
  if [ -e "$target" ] || [ -L "$target" ]; then
    if [ ! -f "$target" ] || [ ! -x "$target" ] || [ -L "$target" ]; then
      echo "==> Refusing to replace unrecognized pen target: $target" >&2
      return 1
    fi
    version_output="$("$target" --version 2>/dev/null || true)"
    if printf '%s\n' "$version_output" | grep -Eq '^pen [0-9]+\.[0-9]+\.[0-9]+$'; then
      installed_version="${version_output#pen }"
    else
      help_output="$("$target" 2>&1 || true)"
      if ! printf '%s\n' "$help_output" | grep -Fq "$recognition"; then
        echo "==> Refusing to replace unrecognized pen target: $target" >&2
        return 1
      fi
    fi
  fi

  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)
      archive="pen-linux-x86_64.tar.gz"
      ;;
    Darwin-arm64)
      archive="pen-macos-aarch64.tar.gz"
      ;;
    *)
      echo "==> pen does not support $(uname -s)-$(uname -m)" >&2
      return 1
      ;;
  esac

  redirect_url="$(curl --proto '=https' --tlsv1.2 -fsS \
    -o /dev/null -w '%{redirect_url}' "$latest_url")"
  latest_version="${redirect_url##*/}"
  if ! printf '%s\n' "$latest_version" \
    | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
    echo "==> Cannot determine latest pen version from $redirect_url" >&2
    return 1
  fi

  if [ -n "$installed_version" ] \
    && [ "$installed_version" = "${latest_version#v}" ]; then
    echo "==> pen ${latest_version} already installed"
    return
  fi

  tmpdir="$(mktemp -d)"
  target_tmp=""
  # 下の trap EXIT から呼ぶ (shellcheck は間接呼び出しを追えない)
  # shellcheck disable=SC2329
  cleanup() {
    rm -rf "$tmpdir"
    [ -z "$target_tmp" ] || rm -f "$target_tmp"
  }
  trap cleanup EXIT
  release_url="https://github.com/miyabi-sunny-side/pen-cli/releases/download/${latest_version}"

  echo "==> Installing pen ${latest_version}..."
  curl --proto '=https' --tlsv1.2 -fsSL \
    "$release_url/$archive" -o "$tmpdir/$archive"
  curl --proto '=https' --tlsv1.2 -fsSL \
    "$release_url/$archive.sha256" -o "$tmpdir/$archive.sha256"

  read -r expected_hash checksum_name checksum_extra <"$tmpdir/$archive.sha256" || true
  checksum_name="${checksum_name#\*}"
  if [ -n "${checksum_extra:-}" ] \
    || ! printf '%s\n' "${expected_hash:-}" | grep -Eq '^[0-9A-Fa-f]{64}$' \
    || [ "${checksum_name:-}" != "$archive" ]; then
    echo "==> Invalid checksum file for pen ${latest_version}" >&2
    return 1
  fi
  if [ "$(uname -s)" = Darwin ]; then
    actual_hash="$(shasum -a 256 "$tmpdir/$archive" | awk '{ print $1 }')"
  else
    actual_hash="$(sha256sum "$tmpdir/$archive" | awk '{ print $1 }')"
  fi
  if [ "$actual_hash" != "$expected_hash" ]; then
    echo "==> Checksum mismatch for pen ${latest_version}" >&2
    return 1
  fi

  tar -xzf "$tmpdir/$archive" -C "$tmpdir" pen
  if [ ! -f "$tmpdir/pen" ] || [ -L "$tmpdir/pen" ]; then
    echo "==> Invalid pen binary in release ${latest_version}" >&2
    return 1
  fi

  extracted_version="$("$tmpdir/pen" --version 2>/dev/null || true)"
  extracted_is_legacy=""
  if printf '%s\n' "$extracted_version" | grep -Eq '^pen [0-9]+\.[0-9]+\.[0-9]+$'; then
    if [ "$extracted_version" != "pen ${latest_version#v}" ]; then
      echo "==> pen binary version does not match ${latest_version}" >&2
      return 1
    fi
  else
    # --version を持たない banner-only binary を受理するのは、version 導入前の
    # 既知 release tag だけ (v0.1.0 は公開済み、v0.1.1 は同内容の local tag)。
    # それ以降の release が --version を欠くのは不正として fail closed
    case "$latest_version" in
      v0.1.0 | v0.1.1) ;;
      *)
        echo "==> pen binary does not look like pen in release ${latest_version}" >&2
        return 1
        ;;
    esac
    if ! "$tmpdir/pen" 2>&1 | grep -Fq "$recognition"; then
      echo "==> pen binary does not look like pen in release ${latest_version}" >&2
      return 1
    fi
    extracted_is_legacy=1
  fi

  # 移行期間の冪等性: 既存 target も抽出物も legacy (banner-only) の場合は
  # hash 比較で同一性を判定し、同一なら再配置しない (旧 hash 方式の維持)
  if [ -n "$extracted_is_legacy" ] && [ -x "$target" ]; then
    if [ "$(uname -s)" = Darwin ]; then
      installed_hash="$(shasum -a 256 "$target" | awk '{ print $1 }')"
      extracted_hash="$(shasum -a 256 "$tmpdir/pen" | awk '{ print $1 }')"
    else
      installed_hash="$(sha256sum "$target" | awk '{ print $1 }')"
      extracted_hash="$(sha256sum "$tmpdir/pen" | awk '{ print $1 }')"
    fi
    if [ "$installed_hash" = "$extracted_hash" ]; then
      echo "==> pen ${latest_version} already installed"
      return
    fi
  fi

  mkdir -p "$HOME/.local/bin"
  target_tmp="$(mktemp "$HOME/.local/bin/.pen.XXXXXX")"
  install -m755 "$tmpdir/pen" "$target_tmp"
  mv -f "$target_tmp" "$target"
  target_tmp=""
  echo "==> pen ${latest_version} installed"
)

# ---------------------------------------------------------------------------
# git-delta — syntax-highlighting pager for git diff/log/show
# ---------------------------------------------------------------------------
install_delta() {
  if command -v delta >/dev/null 2>&1; then
    echo "==> git-delta already installed ($(delta --version))"
    return
  fi

  echo "==> Installing git-delta..."
  if command -v pacman >/dev/null 2>&1; then
    sudo pacman -S --noconfirm git-delta
  elif command -v brew >/dev/null 2>&1; then
    brew install git-delta
  elif command -v apt-get >/dev/null 2>&1; then
    cargo install git-delta
  else
    cargo install git-delta
  fi
  echo "==> git-delta installed ($(delta --version))"
}

# ---------------------------------------------------------------------------
# rbw — Rust 製 Bitwarden CLI (bin/bw/* のバックエンド)
# 常駐 agent が鍵を保持するため公式 bw (Node) より大幅に速い
# ---------------------------------------------------------------------------
install_rbw() {
  if command -v rbw >/dev/null 2>&1; then
    echo "==> rbw already installed ($(rbw --version))"
    return
  fi

  echo "==> Installing rbw..."
  if command -v pacman >/dev/null 2>&1; then
    sudo pacman -S --noconfirm rbw
  elif command -v brew >/dev/null 2>&1; then
    brew install rbw
  else
    cargo install rbw
  fi
  echo "==> rbw installed ($(rbw --version))"
}

# ---------------------------------------------------------------------------
# Obscura — Rust headless browser with V8, used by Claude Code
# Builds from source: not on crates.io, binaries differ per OS/arch.
# First build compiles V8 (a few minutes); later builds are cached.
# ---------------------------------------------------------------------------
install_obscura() {
  if command -v obscura >/dev/null 2>&1; then
    echo "==> Obscura already installed ($HOME/.local/bin/obscura)"
    return
  fi

  if ! command -v cargo >/dev/null 2>&1; then
    cat <<'MSG'
Rust toolchain (cargo) is required but not found.
Install via rustup (Linux / macOS):

  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh

Then restart your shell and re-run this script.
MSG
    exit 1
  fi

  BUILD_DIR="$(mktemp -d)"
  trap 'rm -rf "$BUILD_DIR"' EXIT

  echo "==> Cloning Obscura..."
  git clone --depth 1 https://github.com/h4ckf0r0day/obscura.git "$BUILD_DIR"

  echo "==> Building (first build compiles V8, takes a few minutes)..."
  ( cd "$BUILD_DIR" && cargo build --release )

  DEST="$HOME/.local/bin"
  mkdir -p "$DEST"
  cp "$BUILD_DIR/target/release/obscura" "$BUILD_DIR/target/release/obscura-worker" "$DEST/"
  echo "==> Installed to $DEST/obscura (+ obscura-worker)"
  echo "    Make sure $DEST is on your PATH."
}

# ---------------------------------------------------------------------------

install_agent_clis
install_mux
install_pen
install_delta
install_rbw
install_obscura

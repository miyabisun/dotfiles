#!/usr/bin/env bash
# tmux adapter for mux 0.1.1 until mux ships picker / save-current / close.
# Herdr tab ↔ tmux window, herdr workspace ↔ tmux session (name order, skip _).
set -euo pipefail
export PATH="${HOME}/.fzf/bin:${PATH}"

die() {
  printf 'tmux-mux: %s\n' "$*" >&2
  exit 1
}

usage() {
  die 'usage: tmux-mux picker|save|close|cycle next|cycle previous'
}

mux_config_dir() {
  if [ -n "${MUX_CONFIG:-}" ]; then
    printf '%s\n' "$MUX_CONFIG"
  elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
    printf '%s\n' "${XDG_CONFIG_HOME}/mux"
  else
    printf '%s\n' "${HOME}/.config/mux"
  fi
}

toml_name() {
  sed -n 's/^name = "\([^"]*\)"/\1/p' | head -n 1
}

require_mux() {
  command -v mux >/dev/null 2>&1 || die 'mux not found'
}

visible_sessions() {
  tmux list-sessions -F '#S' 2>/dev/null | awk '!/^_/' | LC_ALL=C sort
}

current_session() {
  tmux display-message -p '#S'
}

session_pane() {
  tmux list-panes -t "=$1" -F '#{pane_id}' | head -n 1
}

snapshot_session() {
  local session="$1"
  local dest="${2:-}"
  local pane
  pane="$(session_pane "$session")"
  [ -n "$pane" ] || die "no pane in session ${session}"
  if [ -n "$dest" ]; then
    TMUX_PANE="$pane" mux snapshot >"$dest"
  else
    TMUX_PANE="$pane" mux snapshot
  fi
}

neighbor_session() {
  local dir="$1"
  local cur="$2"
  visible_sessions | awk -v cur="$cur" -v dir="$dir" '
    { a[++n] = $0 }
    END {
      if (n == 0) exit
      idx = 0
      for (i = 1; i <= n; i++) if (a[i] == cur) idx = i
      if (dir == "next") {
        if (idx == 0 || idx == n) print a[1]
        else print a[idx + 1]
      } else {
        if (idx <= 1) print a[n]
        else print a[idx - 1]
      }
    }'
}

# Keep the client attached when destroying the current session.
# detach-on-destroy is on by default, so switch to the next visible
# neighbor first. A lone session is allowed to end the server.
destroy_session() {
  local session="$1"
  local cur next
  cur="$(current_session)"
  if [ "$session" = "$cur" ]; then
    next="$(neighbor_session next "$cur")"
    if [ -n "$next" ] && [ "$next" != "$session" ]; then
      tmux switch-client -t "=$next"
    fi
  fi
  tmux kill-session -t "=$session"
}

save_session() {
  local session="$1"
  local tmp name
  require_mux
  tmp="$(mktemp "${TMPDIR:-/tmp}/tmux-mux-snap.XXXXXX")"
  if ! snapshot_session "$session" "$tmp"; then
    rm -f "$tmp"
    die "cannot snapshot ${session}"
  fi
  name="$(toml_name <"$tmp")"
  if [ -z "$name" ]; then
    rm -f "$tmp"
    die 'snapshot has no name'
  fi
  if ! mux save --force "$name" <"$tmp"; then
    rm -f "$tmp"
    die "cannot save ${name}"
  fi
  rm -f "$tmp"
  tmux display-message "saved ${name}"
  printf 'saved %s\n' "$name"
}

read_one() {
  local key
  IFS= read -r -n 1 key || return 1
  printf '%s' "$key"
}

is_cancel() {
  case "$1" in
    ''|C|c|$'\033') return 0 ;;
    *) return 1 ;;
  esac
}

cancel_close() {
  rm -f "${1:-}"
  printf 'close cancelled\n' >&2
}

close_session() {
  local session="$1"
  local tmp name saved_file choice
  require_mux
  tmp="$(mktemp "${TMPDIR:-/tmp}/tmux-mux-snap.XXXXXX")"
  if ! snapshot_session "$session" "$tmp"; then
    rm -f "$tmp"
    tmp=""
    printf 'cannot snapshot %s\n[d]iscard / [C]ancel: ' "$session"
    choice="$(read_one)" || choice='C'
    printf '\n'
    is_cancel "$choice" && { cancel_close; return 1; }
    case "$choice" in
      d|D)
        destroy_session "$session"
        printf 'closed %s\n' "$session"
        return 0
        ;;
      *) cancel_close; return 1 ;;
    esac
  fi
  name="$(toml_name <"$tmp")"
  if [ -z "$name" ]; then
    rm -f "$tmp"
    die 'snapshot has no name'
  fi
  saved_file="$(mux_config_dir)/${name}.toml"
  if [ ! -f "$saved_file" ]; then
    printf '%s is unsaved\n[s]ave / [d]iscard / [C]ancel: ' "$session"
    choice="$(read_one)" || choice='C'
    printf '\n'
    is_cancel "$choice" && { cancel_close "$tmp"; return 1; }
    case "$choice" in
      s|S)
        if ! mux save --force "$name" <"$tmp"; then
          rm -f "$tmp"
          die "cannot save ${name}"
        fi
        ;;
      d|D) ;;
      *) cancel_close "$tmp"; return 1 ;;
    esac
  elif cmp -s "$tmp" "$saved_file"; then
    :
  else
    printf '%s has unsaved changes\n[u]pdate / [d]iscard / [C]ancel: ' "$session"
    choice="$(read_one)" || choice='C'
    printf '\n'
    is_cancel "$choice" && { cancel_close "$tmp"; return 1; }
    case "$choice" in
      u|U)
        if ! mux save --force "$name" <"$tmp"; then
          rm -f "$tmp"
          die "cannot save ${name}"
        fi
        ;;
      d|D) ;;
      *) cancel_close "$tmp"; return 1 ;;
    esac
  fi
  rm -f "$tmp"
  destroy_session "$session"
  printf 'closed %s\n' "$session"
}

open_saved() {
  local name="$1"
  local shim status
  require_mux
  shim="$(mktemp -d "${TMPDIR:-/tmp}/tmux-mux-fzf.XXXXXX")"
  cat >"${shim}/fzf" <<'EOF'
#!/bin/sh
printf '%s\n' "${MUX_SELECT:-}"
EOF
  chmod +x "${shim}/fzf"
  status=0
  MUX_SELECT="$name" PATH="${shim}:${PATH}" mux || status=$?
  rm -rf "$shim"
  return "$status"
}

picker_rows() {
  local live saved
  live="$(visible_sessions || true)"
  saved="$(mux ls 2>/dev/null || true)"
  {
    [ -n "$live" ] && printf '%s\n' "$live" | sed 's/^/live /'
    [ -n "$saved" ] && printf '%s\n' "$saved" | sed 's/^/saved /'
    true
  } | awk '
    $1 == "live" {
      sub(/^live /, "")
      if ($0 != "") { live[$0] = 1; seen[$0] = 1 }
    }
    $1 == "saved" {
      sub(/^saved /, "")
      if ($0 != "") { saved[$0] = 1; seen[$0] = 1 }
    }
    END {
      for (n in seen) print n
    }
  ' | LC_ALL=C sort | while IFS= read -r name; do
    [ -n "$name" ] || continue
    if printf '%s\n' "$live" | grep -Fxq "$name"; then
      printf '● %s\n' "$name"
    else
      printf '○ %s\n' "$name"
    fi
  done
}

row_name() {
  printf '%s\n' "$1" | sed 's/^[^ ]* //'
}

row_is_live() {
  case "$1" in
    '● '*) return 0 ;;
    *) return 1 ;;
  esac
}

run_picker() {
  export PATH="${HOME}/.fzf/bin:${PATH}"
  command -v fzf >/dev/null 2>&1 || die 'fzf not found'
  while :; do
    local rows out key row name
    rows="$(picker_rows)"
    if [ -z "$rows" ]; then
      die 'no saved or running sessions'
    fi
    # fzf expands {} in the preview script; this is not a bash expansion.
    # shellcheck disable=SC2016
    if ! out="$(printf '%s\n' "$rows" | fzf --reverse --prompt='mux> ' \
      --expect=space --bind=space:accept --no-multi \
      --preview 'name=$(printf "%s\n" {} | sed "s/^[^ ]* //")
        if tmux has-session -t "=$name" 2>/dev/null; then
          tmux list-windows -t "=$name" -F "#I: #W (#{pane_current_command})"
          printf "\n"
          tmux capture-pane -ep -t "=$name"
        else
          mux check "$name" 2>/dev/null || true
        fi' \
      --preview-window=right,65%)"; then
      return 0
    fi
    key="$(printf '%s\n' "$out" | sed -n '1p')"
    row="$(printf '%s\n' "$out" | sed -n '2p')"
    [ -n "$row" ] || return 0
    name="$(row_name "$row")"
    [ -n "$name" ] || return 0
    if [ "$key" = space ]; then
      if row_is_live "$row"; then
        close_session "$name" || true
        continue
      fi
      open_saved "$name"
      return 0
    fi
    if row_is_live "$row"; then
      if [ -n "${TMUX:-}" ]; then
        tmux switch-client -t "=$name"
      else
        tmux attach -t "=$name"
      fi
    else
      open_saved "$name"
    fi
    return 0
  done
}

cycle() {
  local dir="$1"
  local cur target
  cur="$(current_session)"
  target="$(neighbor_session "$dir" "$cur")"
  [ -n "$target" ] || return 0
  [ "$target" = "$cur" ] && return 0
  tmux switch-client -t "=$target"
}

cmd="${1:-}"
case "$cmd" in
  picker) run_picker ;;
  save)
    shift
    save_session "${1:-$(current_session)}"
    ;;
  close)
    shift
    close_session "${1:-$(current_session)}"
    ;;
  cycle)
    [ "${2:-}" = next ] || [ "${2:-}" = previous ] || usage
    cycle "$2"
    ;;
  *) usage ;;
esac

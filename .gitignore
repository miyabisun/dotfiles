# tmux plugins managed by tpm
config/tmux/plugins/

# per-machine colorscheme choice
config/nvim/colorscheme.txt

# Ignore legacy Herdr-generated files. The session wrapper is repo-owned;
# bin/install generates the actual integration outside this checkout.
agent/claude/hooks/herdr-*.sh
!agent/claude/hooks/herdr-agent-state.sh

# local Python bytecode (herdr helpers and anything else)
__pycache__/

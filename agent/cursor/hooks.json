{
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "./hooks/block-git-discard.sh",
        "matcher": "git "
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/agent-talk-busy.sh"
      }
    ],
    "preToolUse": [
      {
        "command": "./hooks/prefer-semble.sh",
        "matcher": "Grep|Glob"
      }
    ],
    "sessionStart": [
      {
        "command": "bash '/home/miyabi/.cursor/herdr-agent-state.sh' session"
      }
    ],
    "stop": [
      {
        "command": "./hooks/stop-turn-end.sh"
      }
    ],
    "subagentStart": [
      {
        "command": "./hooks/guard-subagent-dirty-tree.sh"
      }
    ]
  },
  "version": 1
}
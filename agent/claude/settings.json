{
  "permissions": {
    "allow": [
      "Skill(deliver)",
      "Skill(git)",
      "Skill(knowledge-read)",
      "Bash(~/.local/bin/notify-file-permission.sh:*)",
      "Bash(ssh sandbox *)"
    ],
    "deny": [
      "Bash(bw:*)",
      "Bash(rbw:*)",
      "Read(~/.config/.secrets*)",
      "Read(~/.config/cloudflare/**)",
      "Edit(~/.config/cloudflare/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.development.local)",
      "Read(**/.env.test)",
      "Read(**/.env.test.local)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.production.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.development.local)",
      "Edit(**/.env.test)",
      "Edit(**/.env.test.local)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)",
      "Edit(**/.env.production.local)"
    ],
    "defaultMode": "auto"
  },
  "outputStyle": "Concise",
  "crossSessionInbound": "accept",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify-waiting.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/meiseki-lint-markdown.sh\"",
            "timeout": 60,
            "statusMessage": "Markdown の日本語 lint (meiseki)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-git-discard.sh\"",
            "timeout": 10,
            "statusMessage": "git 破棄コマンドチェック"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/bin/agent-test\" hook",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/stop-turn-end.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/bin/agent-test\" hook",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "language": "Japanese",
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "skipAutoPermissionPrompt": true,
  "mcpServers": {
    "obscura": {
      "args": [
        "mcp"
      ],
      "command": "obscura",
      "env": {},
      "type": "stdio"
    }
  }
}

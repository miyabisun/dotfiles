{
  "effortLevel": "high",
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/agent/claude/hooks/notify-waiting.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "test -f Cargo.toml && cargo fmt --check 2>&1 && cargo clippy --quiet 2>&1 && cargo test --quiet 2>&1 || true",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "test -f package.json && { npx --no vitest --version >/dev/null 2>&1 || { echo 'ERROR: vitest is not installed. Run: npm install -D vitest'; exit 1; }; npx --no vitest run --reporter=verbose 2>&1; } || true",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "vite_config=$(ls vite.config.* client/vite.config.* 2>/dev/null | head -1) && test -n \"$vite_config\" && { dir=$(dirname \"$vite_config\"); if [ \"$dir\" != \".\" ]; then cd \"$dir\"; fi; npx vite build 2>&1 | tail -5; } || true",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/agent/claude/hooks/webfetch-fallback.sh",
            "type": "command"
          }
        ],
        "matcher": "WebFetch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/agent/claude/hooks/prefer-semble.sh",
            "type": "command"
          }
        ],
        "matcher": "Grep|Glob"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/agent/claude/hooks/block-git-discard.sh",
            "statusMessage": "git 破棄コマンドチェック",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/agent/claude/hooks/unregister-agent-talk.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/agent/claude/hooks/register-agent-talk.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/home/miyabi/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/agent/claude/hooks/stop-turn-end.sh",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/agent/claude/hooks/agent-talk-busy.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "language": "Japanese",
  "mcpServers": {
    "obscura": {
      "args": [
        "mcp"
      ],
      "command": "obscura",
      "env": {},
      "type": "stdio"
    }
  },
  "model": "claude-fable-5[1m]",
  "permissions": {
    "allow": [
      "Skill(deliver)",
      "Skill(consolidate)",
      "Skill(commit)",
      "Bash(~/.local/bin/notify-file-permission.sh:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(bw:*)",
      "Bash(rbw:*)",
      "Read(~/.config/.secrets*)",
      "Read(~/.config/cloudflare/**)",
      "Edit(~/.config/cloudflare/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.development.local)",
      "Read(**/.env.test)",
      "Read(**/.env.test.local)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.production.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.development.local)",
      "Edit(**/.env.test)",
      "Edit(**/.env.test.local)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)",
      "Edit(**/.env.production.local)"
    ]
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "tui": "fullscreen"
}
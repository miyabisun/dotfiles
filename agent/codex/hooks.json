{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/agent/codex/hooks/block-git-discard.sh",
            "statusMessage": "git 破棄コマンドチェック",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/miyabi/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.local/share/agent-talk/current/agent-talk busy",
            "statusMessage": "agent-talk busy 宣言",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/agent/codex/hooks/block-git-discard.sh",
            "statusMessage": "git 破棄コマンドチェック",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}

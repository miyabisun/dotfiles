#!/bin/bash
# meiseki (日本語明晰化) 召喚の唯一の起動形。決定論層 (meiseki-lint) と
# リライト層 (meiseki-rewrite) を束ねる。
#
#   meiseki <file>
#   echo "冗長な日本語" | meiseki
#
# lint が何も言わなければ、その本文はすでに明晰なのでバイト等価でそのまま返す
# (claude は起動しない)。lint が finding を出したときだけ meiseki-rewrite を
# 1 回だけ呼び、その stdout と exit code を透過する。lint が判定できなければ
# (前提エラー) リライトへは進まない。
#
# 兄弟の実行ファイルは MEISEKI_LINT / MEISEKI_REWRITE で差し替えられる。
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
[[ -n "$self" ]] || {
    echo 'meiseki: cannot resolve its own path' >&2
    exit 2
}
bin_dir="$(dirname "$self")"
meiseki_prog="meiseki"
meiseki_usage_note='明晰化した本文を stdout へ出す。入力ファイルは書き換えない。'
# shellcheck source=meiseki-common.sh
source "$bin_dir/meiseki-common.sh"

parse_args "$@"

lint="${MEISEKI_LINT:-$bin_dir/meiseki-lint}"
rewrite="${MEISEKI_REWRITE:-$bin_dir/meiseki-rewrite}"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

input="$work/input.md"
read_input "$input"

# findings JSON は user の成果物ではないので捨てる (成果物は本文だけであり、
# clean な入力でも毎回 JSON が流れると本文と混ざる)。
set +e
"$lint" "$input" >/dev/null
lint_status=$?
set -e

if [[ "$lint_status" -eq 0 ]]; then
    # 何も言われなかった本文はすでに明晰である。1 byte も足さずにそのまま返す
    cat "$input"
    exit 0
fi
# 1 以外 = 判定できていない。リライトへは進まない
[[ "$lint_status" -eq 1 ]] || exit "$lint_status"

set +e
"$rewrite" "$input"
status=$?
set -e

exit "$status"

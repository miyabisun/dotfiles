#!/usr/bin/env python3
"""User-level test receipts for agent PreToolUse/Stop hooks."""
import hashlib
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "agent-test"


def git(root, *args):
    return subprocess.check_output(["git", "-C", str(root), *args], stderr=subprocess.DEVNULL)


def root_at(cwd):
    return Path(os.fsdecode(git(cwd, "rev-parse", "--show-toplevel")).strip())


def receipt(root):
    return STATE / (hashlib.sha256(os.fsencode(root)).hexdigest() + ".json")


def read(root):
    try:
        return json.loads(receipt(root).read_text())
    except FileNotFoundError:
        return {}


def write(root, data):
    STATE.mkdir(parents=True, exist_ok=True)
    data["root"] = str(root)
    with tempfile.NamedTemporaryFile(mode="w", dir=STATE, delete=False) as out:
        json.dump(data, out)
    os.replace(out.name, receipt(root))


def digest(root):
    result = hashlib.sha256()
    for name in sorted(set(git(root, "ls-files", "-co", "--exclude-standard", "-z").split(b"\0")) - {b""}):
        path = root / os.fsdecode(name)
        if path.is_symlink():
            content = b"link:" + os.fsencode(os.readlink(path))
        elif path.is_file():
            content = str(path.stat().st_mode & 0o111).encode() + b":" + path.read_bytes()
        elif path.is_dir():
            raise ValueError("submodule contents require a separate test run")
        else:
            continue
        result.update(name + b"\0")
        result.update(hashlib.sha256(content).digest())
    return result.hexdigest()


def problem(root, committing=False):
    saved = read(root)
    if saved.get("status") != "passed" or saved.get("digest") != digest(root):
        return f"{root}: agent-test run -- <test command> を通してください。中断報告のみなら agent-test pause。"
    if committing:
        staged = set(git(root, "diff", "--cached", "--name-only", "-z").split(b"\0"))
        unstaged = set(git(root, "diff", "--name-only", "-z").split(b"\0"))
        if (staged & unstaged) - {b""}:
            return "部分stageの内容は検証していません。検証済みのファイル全体をstageしてください。"
    return ""


def commands(command, cwd):
    # ponytail: recognize direct shell commands; wrappers/scripts are outside this hook's scope.
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|\n")
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    try:
        tokens = list(lexer)
    except ValueError:
        return
    parts, current = [], []
    for token in tokens:
        if token and all(c in ";&|\n" for c in token):
            if current:
                parts.append(current)
                current = []
        else:
            current.append(token)
    if current:
        parts.append(current)
    mutations = False
    for args in parts:
        if args[0] == "cd" and len(args) == 2:
            cwd = Path(cwd) / os.path.expanduser(args[1])
            continue
        name = Path(args[0]).name
        if name == "agent-test" and args[1:2] == ["run"]:
            yield "run", root_at(cwd), mutations
        elif name == "git":
            target, rest = Path(cwd), args[1:]
            while rest[:1] == ["-C"] and len(rest) > 1:
                target = target / rest[1]
                rest = rest[2:]
            if rest[:1] == ["commit"]:
                yield "commit", root_at(target), mutations
        mutations = True


def hook(event):
    session = event.get("session_id", "")
    reason = ""
    stop = event.get("hook_event_name") == "Stop"
    try:
        if stop:
            for path in STATE.glob("*.json"):
                saved = json.loads(path.read_text())
                if session and saved.get("session_id") == session and saved.get("status") != "paused":
                    reason = problem(Path(saved["root"]))
                    if reason:
                        break
        else:
            data = event.get("tool_input", {})
            for action, root, compound in commands(data.get("command", ""), data.get("workdir") or event.get("cwd") or os.getcwd()):
                if action == "run":
                    write(root, {"session_id": session, "status": "pending"})
                else:
                    reason = "stage・検証・commitは別コマンドで実行してください。" if compound else problem(root, True)
                    if reason:
                        break
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        reason = f"test gateを確認できません: {error}"
    if not reason:
        return {}
    if stop:
        return {"decision": "block", "reason": reason}
    return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": reason}}


def main():
    if sys.argv[1:] == ["hook"]:
        print(json.dumps(hook(json.load(sys.stdin)), ensure_ascii=False))
        return 0
    root = root_at(Path.cwd())
    saved = read(root)
    if sys.argv[1:] == ["pause"]:
        saved["status"] = "paused"
        write(root, saved)
        return 0
    if sys.argv[1:3] != ["run", "--"] or len(sys.argv) < 4:
        raise ValueError("usage: agent-test run -- <test command> | pause | hook")
    saved["status"] = "failed"
    write(root, saved)
    before = digest(root)
    result = subprocess.run(sys.argv[3:])
    if result.returncode:
        return result.returncode
    if before != digest(root):
        raise ValueError("検証中にファイルが変わりました。再実行してください。")
    saved.update(status="passed", digest=before)
    write(root, saved)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"agent-test: {error}", file=sys.stderr)
        sys.exit(1)

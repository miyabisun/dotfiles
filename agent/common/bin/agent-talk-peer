#!/bin/bash
set -euo pipefail

usage() {
    printf '%s\n' \
        'usage: agent-talk-peer who' \
        '       agent-talk-peer read <message-id>' \
        '       agent-talk-peer reply <message-id> [--] [message]' \
        '       agent-talk-peer send <addr> [--no-reply] [--] [message]' \
        '       agent-talk-peer send knowledge/codex --no-reply --body-file <path> --sha256 <hash>' >&2
    exit 2
}

SELF_PATH="${BASH_SOURCE[0]}"
[[ ! -L "$SELF_PATH" ]] || usage
[[ "$SELF_PATH" == */* ]] || usage
SELF_PARENT="${SELF_PATH%/*}"
SELF_DIR="$(cd -- "$SELF_PARENT" && pwd -P)"
BROKER="$SELF_DIR/agent-talk"
[[ -f "$BROKER" && -x "$BROKER" && ! -L "$BROKER" ]] || {
    printf 'trusted agent-talk broker is unavailable\n' >&2
    exit 126
}

[[ "$#" -ge 1 ]] || usage
SUBCOMMAND="$1"
shift

case "$SUBCOMMAND" in
    who)
        [[ "$#" -eq 0 ]] || usage
        exec "$BROKER" who
        ;;
    read)
        [[ "$#" -eq 1 && "$1" =~ ^[0-9]+$ ]] || usage
        exec "$BROKER" read "$1"
        ;;
    reply)
        [[ "$#" -ge 1 && "$1" =~ ^[0-9]+$ ]] || usage
        MESSAGE_ID="$1"
        shift
        if [[ "$#" -eq 0 ]]; then
            exec "$BROKER" reply "$MESSAGE_ID"
        fi
        [[ "$1" == "--" ]] || usage
        shift
        [[ "$#" -le 1 ]] || usage
        if [[ "$#" -eq 1 ]]; then
            exec "$BROKER" reply "$MESSAGE_ID" -- "$1"
        fi
        exec "$BROKER" reply "$MESSAGE_ID"
        ;;
    send)
        [[ "$#" -ge 1 ]] || usage
        TARGET="$1"
        shift
        NAME_SEGMENT='[A-Za-z0-9._][A-Za-z0-9._-]*'
        [[ "$TARGET" =~ ^(%[0-9]+|${NAME_SEGMENT}(/${NAME_SEGMENT})?)$ ]] || usage

        COMMAND_ARGS=(send "$TARGET")
        NO_REPLY=0
        if [[ "${1:-}" == "--no-reply" ]]; then
            COMMAND_ARGS+=(--no-reply)
            NO_REPLY=1
            shift
        fi
        if [[ "$#" -eq 0 ]]; then
            exec "$BROKER" "${COMMAND_ARGS[@]}"
        fi
        if [[ "$1" == "--body-file" ]]; then
            [[ "$TARGET" == "knowledge/codex" && "$NO_REPLY" -eq 1 \
                && "$#" -eq 4 && "$3" == "--sha256" ]] || usage
            BODY_FILE="$2"
            EXPECTED_HASH="$4"
            [[ "$BODY_FILE" =~ ^/tmp/agent-knowledge\.[A-Za-z0-9]{6}$ \
                && -f "$BODY_FILE" && -r "$BODY_FILE" && -O "$BODY_FILE" \
                && ! -L "$BODY_FILE" \
                && "$EXPECTED_HASH" =~ ^[0-9a-f]{64}$ ]] || usage

            RUNTIME_PATHS="$SELF_DIR/.dotfiles-agent-runtime"
            [[ -f "$RUNTIME_PATHS" && ! -L "$RUNTIME_PATHS" ]] || exit 126
            SHA256_BIN=""
            SHA256_MODE=""
            CP_BIN=""
            RM_BIN=""
            STAT_BIN=""
            STAT_MODE=""
            SEEN_TMUX=0
            SEEN_CURL=0
            SEEN_SHA256=0
            SEEN_SHA256_MODE=0
            SEEN_CP=0
            SEEN_RM=0
            SEEN_STAT=0
            SEEN_STAT_MODE=0
            while IFS= read -r RUNTIME_LINE || [[ -n "$RUNTIME_LINE" ]]; do
                case "$RUNTIME_LINE" in
                    TMUX_BIN=*)
                        [[ "$SEEN_TMUX" -eq 0 ]] || exit 126
                        SEEN_TMUX=1
                        ;;
                    CURL_BIN=*)
                        [[ "$SEEN_CURL" -eq 0 ]] || exit 126
                        SEEN_CURL=1
                        ;;
                    SHA256_BIN=*)
                        [[ "$SEEN_SHA256" -eq 0 ]] || exit 126
                        SHA256_BIN="${RUNTIME_LINE#SHA256_BIN=}"
                        SEEN_SHA256=1
                        ;;
                    SHA256_MODE=*)
                        [[ "$SEEN_SHA256_MODE" -eq 0 ]] || exit 126
                        SHA256_MODE="${RUNTIME_LINE#SHA256_MODE=}"
                        SEEN_SHA256_MODE=1
                        ;;
                    CP_BIN=*)
                        [[ "$SEEN_CP" -eq 0 ]] || exit 126
                        CP_BIN="${RUNTIME_LINE#CP_BIN=}"
                        SEEN_CP=1
                        ;;
                    RM_BIN=*)
                        [[ "$SEEN_RM" -eq 0 ]] || exit 126
                        RM_BIN="${RUNTIME_LINE#RM_BIN=}"
                        SEEN_RM=1
                        ;;
                    STAT_BIN=*)
                        [[ "$SEEN_STAT" -eq 0 ]] || exit 126
                        STAT_BIN="${RUNTIME_LINE#STAT_BIN=}"
                        SEEN_STAT=1
                        ;;
                    STAT_MODE=*)
                        [[ "$SEEN_STAT_MODE" -eq 0 ]] || exit 126
                        STAT_MODE="${RUNTIME_LINE#STAT_MODE=}"
                        SEEN_STAT_MODE=1
                        ;;
                    *) exit 126 ;;
                esac
            done <"$RUNTIME_PATHS"
            [[ "$SEEN_TMUX" -eq 1 && "$SEEN_CURL" -eq 1 \
                && "$SEEN_SHA256" -eq 1 && "$SEEN_SHA256_MODE" -eq 1 \
                && "$SEEN_CP" -eq 1 && "$SEEN_RM" -eq 1 \
                && "$SEEN_STAT" -eq 1 && "$SEEN_STAT_MODE" -eq 1 \
                && "$SHA256_BIN" == /* && -x "$SHA256_BIN" \
                && "$CP_BIN" == /* && -x "$CP_BIN" \
                && "$RM_BIN" == /* && -x "$RM_BIN" \
                && "$STAT_BIN" == /* && -x "$STAT_BIN" ]] || exit 126
            for RUNTIME_VALUE in "$SHA256_BIN" "$CP_BIN" "$RM_BIN" \
                "$STAT_BIN"; do
                [[ "$RUNTIME_VALUE" != *[$' \t\r\n']* ]] || exit 126
            done
            case "$STAT_MODE" in
                gnu) BODY_MODE="$("$STAT_BIN" -c %a -- "$BODY_FILE")" ;;
                bsd) BODY_MODE="$("$STAT_BIN" -f %Lp "$BODY_FILE")" ;;
                *) exit 126 ;;
            esac
            [[ "$BODY_MODE" == "600" ]] || usage

            BODY_SNAPSHOT=""
            cleanup_body_snapshot() {
                if [[ -n "$BODY_SNAPSHOT" && -f "$BODY_SNAPSHOT" \
                    && ! -L "$BODY_SNAPSHOT" ]]; then
                    "$RM_BIN" -f -- "$BODY_SNAPSHOT" 2>/dev/null || true
                fi
            }
            trap cleanup_body_snapshot EXIT
            umask 077
            for _ in 1 2 3 4 5 6 7 8; do
                BODY_SNAPSHOT="$SELF_DIR/.agent-talk-body.$$.$RANDOM"
                if (set -o noclobber; : >"$BODY_SNAPSHOT") 2>/dev/null; then
                    break
                fi
                BODY_SNAPSHOT=""
            done
            [[ -n "$BODY_SNAPSHOT" ]] || exit 126
            "$CP_BIN" -- "$BODY_FILE" "$BODY_SNAPSHOT" || exit 126
            [[ -f "$BODY_SNAPSHOT" && ! -L "$BODY_SNAPSHOT" ]] || exit 126
            case "$SHA256_MODE" in
                sha256sum) HASH_OUTPUT="$("$SHA256_BIN" "$BODY_SNAPSHOT")" ;;
                shasum) HASH_OUTPUT="$("$SHA256_BIN" -a 256 "$BODY_SNAPSHOT")" ;;
                *) exit 126 ;;
            esac
            ACTUAL_HASH="${HASH_OUTPUT%% *}"
            [[ "$ACTUAL_HASH" == "$EXPECTED_HASH" ]] || {
                printf 'body file hash mismatch\n' >&2
                exit 2
            }
            exec 3<"$BODY_SNAPSHOT"
            "$RM_BIN" -f -- "$BODY_SNAPSHOT" || exit 126
            BODY_SNAPSHOT=""
            trap - EXIT
            exec "$BROKER" "${COMMAND_ARGS[@]}" <&3
        fi
        [[ "$1" == "--" ]] || usage
        shift
        [[ "$#" -le 1 ]] || usage
        COMMAND_ARGS+=(--)
        if [[ "$#" -eq 1 ]]; then
            COMMAND_ARGS+=("$1")
        fi
        exec "$BROKER" "${COMMAND_ARGS[@]}"
        ;;
    *)
        usage
        ;;
esac
